# Environment Variables Template
# Copy this file to .env and fill in the actual values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
# Database-per-service: AIServices owns ai_db (CoreServices uses core_db)
AI_DB_NAME=ai_db

# File Upload Configuration
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE=5242880  # 5MB in bytes
# Old .doc files are converted to .docx with LibreOffice (free: libreoffice.org).
# Leave empty to auto-detect soffice on PATH or in the usual install folders, e.g.
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
#   Linux:   /usr/bin/soffice
# Without LibreOffice, .doc uploads fail with DOC_UNSUPPORTED (PDF/DOCX still work).
LIBREOFFICE_PATH=
DOC_CONVERT_TIMEOUT_SECONDS=30

# NLP Configuration
NLP_MODEL=en_core_web_sm

# Skill embeddings (sentence-transformers; the vector size comes from the model,
# 384 for bge-small). The model downloads once (~130 MB) into EMBEDDING_CACHE_DIR, then loads from
# there with no network access (fully offline). Pre-download for an offline
# machine by starting the service once while online, or copy the folder.
# HF_HOME / SENTENCE_TRANSFORMERS_HOME are NOT needed: EMBEDDING_CACHE_DIR is
# passed to the model loader directly. Set HF_HUB_OFFLINE=1 to forbid any
# download attempt (startup then fails fast if the model is not cached).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# description = embed "Name: description" (curated file) when known, else the name;
# name = embed bare names. The benchmark chose bge-small + description.
EMBEDDING_TEXT_MODE=description
# Related-skill threshold for future matching (benchmark v2: >= 95% precision,
# 94% recall). Valid ONLY for the model and text mode it was measured with;
# matching refuses it otherwise (re-measure first).
EMBEDDING_RELATED_THRESHOLD=0.73
EMBEDDING_THRESHOLD_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_THRESHOLD_TEXT_MODE=description
EMBEDDING_CACHE_DIR=./models
# false = do not load the model at startup (tests use a fake embedder).
EMBEDDING_AUTOLOAD=true
# How often the background worker completes pending embeddings (seconds).
EMBEDDING_WORKER_INTERVAL_SECONDS=30

# Authentication
# Must match CoreServices JWT_SECRET exactly
JWT_SECRET=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5174"]


# Service-to-service (internal REST to CoreServices)
CORE_SERVICE_URL=http://localhost:3000
# Shared secret sent as X-Internal-Key; must match CoreServices INTERNAL_API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Seconds to cache each user's auth state from CoreServices. A suspension or
# password change reaches this service within this window.
AUTH_CACHE_TTL_SECONDS=30

# Error-log retention in days (TTL index on error_logs.timestamp).
LOG_RETENTION_DAYS=30
