# Environment Variables Template
# Copy this file to .env and fill in the actual values

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=False

# Database Configuration
MONGODB_URL=mongodb://localhost:27017
# Database-per-service: AIServices owns ai_db (CoreServices uses core_db)
AI_DB_NAME=ai_db

# File Upload Configuration
UPLOAD_DIRECTORY=./uploads
MAX_FILE_SIZE=5242880  # 5MB in bytes
# Old .doc files are converted to .docx with LibreOffice (free: libreoffice.org).
# Leave empty to auto-detect soffice on PATH or in the usual install folders, e.g.
#   Windows: C:\Program Files\LibreOffice\program\soffice.exe
#   Linux:   /usr/bin/soffice
# Without LibreOffice, .doc uploads fail with DOC_UNSUPPORTED (PDF/DOCX still work).
LIBREOFFICE_PATH=
DOC_CONVERT_TIMEOUT_SECONDS=30

# NLP Configuration
NLP_MODEL=en_core_web_sm

# Skill embeddings (sentence-transformers; the vector size comes from the model,
# 384 for bge-small). The model downloads once (~130 MB) into EMBEDDING_CACHE_DIR, then loads from
# there with no network access (fully offline). Pre-download for an offline
# machine by starting the service once while online, or copy the folder.
# HF_HOME / SENTENCE_TRANSFORMERS_HOME are NOT needed: EMBEDDING_CACHE_DIR is
# passed to the model loader directly. Set HF_HUB_OFFLINE=1 to forbid any
# download attempt (startup then fails fast if the model is not cached).
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# description = embed "Name: description" (curated file) when known, else the name;
# name = embed bare names. The benchmark chose bge-small + description.
EMBEDDING_TEXT_MODE=description
# Related-skill threshold for future matching (benchmark v2: >= 95% precision,
# 94% recall). Valid ONLY for the model and text mode it was measured with;
# matching refuses it otherwise (re-measure first).
EMBEDDING_RELATED_THRESHOLD=0.73
EMBEDDING_THRESHOLD_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_THRESHOLD_TEXT_MODE=description

# Profession database (ESCO + O*NET) and the FAISS role-skill index.
# Raw dataset folder (AIServices/data/raw, see its README for downloads and attribution).
PROFESSION_DATA_DIR=../data/raw
# Sources active in the role-skill index (onet, esco, manual).
PROFESSION_SOURCES=onet,esco,curated,manual
# O*NET occupations kept: SOC code prefixes, minus exact codes to exclude (catch-alls).
ONET_SOC_PREFIXES=15-12,15-2051
ONET_SOC_EXCLUDE=15-1299.00
# Software skills kept per O*NET occupation (Hot Technology or In Demand only).
ONET_SKILLS_CAP=30
ONET_VERSION=31.0
# ESCO occupations kept: ISCO group prefixes.
ESCO_ISCO_PREFIXES=251,252,351,3522,2166
ESCO_VERSION=1.2.1
# Use ESCO skill descriptions as embedding text (off until benchmarked).
ESCO_DESCRIPTIONS_ENABLED=false
# Where the FAISS index and its meta file are saved (git-ignored).
ROLE_INDEX_DIR=../data/index
# Top-k used for the mutual-nearest-neighbour flag.
MUTUAL_NN_K=10
# Load the saved role-skill index at startup, or rebuild it in the background.
ROLE_INDEX_AUTOLOAD=true

# Admin taxonomy jobs (09c). Publish/restore/edit hold one lock in ai_db, renewed by a
# heartbeat while the job runs; if the holder dies the lock expires after the TTL.
TAXONOMY_LOCK_TTL_SECONDS=300
TAXONOMY_LOCK_HEARTBEAT_SECONDS=60
# The running AI service writes a heartbeat (ai_db.service_heartbeats) so the CLI
# importers can warn that the service needs a rebuild or restart after an offline import.
SERVICE_HEARTBEAT_SECONDS=60
SERVICE_HEARTBEAT_ENABLED=true
# Staging uploads and snapshots, OUTSIDE the repository. Empty = ~/.muqayyim/taxonomy.
TAXONOMY_WORK_DIR=
# Upload limits: total upload, total uncompressed ZIP size, ZIP entries (zip-bomb guard).
TAXONOMY_MAX_UPLOAD_MB=100
TAXONOMY_MAX_UNZIPPED_MB=500
TAXONOMY_MAX_ZIP_ENTRIES=500
# Unfinished jobs' staging files are deleted after this many hours (checked hourly).
TAXONOMY_STAGING_TTL_HOURS=24
TAXONOMY_CLEANUP_INTERVAL_SECONDS=3600
# Snapshots kept: publish/restore pool and direct-edit pool (older ones are deleted).
TAXONOMY_SNAPSHOTS_KEEP=5
TAXONOMY_EDIT_SNAPSHOTS_KEEP=10
# Seconds between checks for a publish that crashed (restored from its snapshot).
TAXONOMY_RECOVERY_INTERVAL_SECONDS=60
EMBEDDING_CACHE_DIR=./models
# false = do not load the model at startup (tests use a fake embedder).
EMBEDDING_AUTOLOAD=true
# How often the background worker completes pending embeddings (seconds).
EMBEDDING_WORKER_INTERVAL_SECONDS=30

# Authentication
# Must match CoreServices JWT_SECRET exactly
JWT_SECRET=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://localhost:5174"]


# Service-to-service (internal REST to CoreServices)
CORE_SERVICE_URL=http://localhost:3000
# Shared secret sent as X-Internal-Key; must match CoreServices INTERNAL_API_KEY.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Seconds to cache each user's auth state from CoreServices. A suspension or
# password change reaches this service within this window.
AUTH_CACHE_TTL_SECONDS=30

# Error-log retention in days (TTL index on error_logs.timestamp).
LOG_RETENTION_DAYS=30

# ── LLM (12) — one shared client in AIServices; Core and the frontend never see the key ──
# Off until enabled. With LLM_PROVIDER=fake no key is needed (tests, offline development).
LLM_ENABLED=false
LLM_PROVIDER=gemini
# gemini-3.5-flash-lite (default) or gemini-3.8-flash
LLM_MODEL=gemini-3.5-flash-lite
# Your Google AI Studio key. Never commit it; it is never logged.
LLM_API_KEY=your-gemini-api-key
LLM_TIMEOUT_S=15
LLM_MAX_OUTPUT_TOKENS=1024
LLM_MAX_RETRIES=2
# Your project's limits for LLM_MODEL (see aistudio.google.com/rate-limit); the limiter allows
# LLM_LIMIT_FRACTION of them. Google applies limits per project; the day resets at midnight Pacific.
LLM_RPM=5
LLM_TPM=100000
LLM_RPD=100
LLM_LIMIT_FRACTION=0.8
# Per-user AI calls per day, and how long identical requests are answered from the cache.
LLM_USER_DAILY_QUOTA=20
LLM_CACHE_TTL_DAYS=7
