# API Gateway Configuration
PORT=8080

# Downstream microservices (/internal/* is never proxied)
AUTH_SERVICE_URL=http://localhost:3000
CV_SERVICE_URL=http://localhost:8000

# Frontend origin allowed by CORS (the only UI)
FRONTEND_URL=http://localhost:5174

# Which proxies may set X-Forwarded-For (so req.ip is the real client, needed
# for rate limiting). loopback = local dev (default). Behind Railway/Render's
# proxy set the hop count, usually 1.
TRUST_PROXY=loopback

# ── Rate limiting (per client IP; in-memory store = per gateway instance) ──────
# Set to false to disable all limits (e.g. for load tests).
RATE_LIMIT_ENABLED=true
# All /api routes
RATE_LIMIT_GLOBAL_MAX=600
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
# POST /api/auth/login (admins log in here too) — counts FAILED attempts only
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
# POST /api/auth/register
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
# POST /api/auth/forgot-password and /api/auth/reset-password/:token (shared budget)
RATE_LIMIT_PASSWORD_RESET_MAX=5
RATE_LIMIT_PASSWORD_RESET_WINDOW_MINUTES=60
# POST /api/cv/upload
RATE_LIMIT_CV_UPLOAD_MAX=20
RATE_LIMIT_CV_UPLOAD_WINDOW_MINUTES=60

# ── Request size (by Content-Length, checked before proxying) ──────────────────
GATEWAY_MAX_BODY_BYTES=1048576      # 1 MB for every /api route except CV upload
GATEWAY_MAX_UPLOAD_BYTES=6291456    # 6 MB for /api/cv/upload (AIServices enforces 5 MB per file)

# ── Upstream timeouts (inactivity, milliseconds) ──────────────────────────────
GATEWAY_PROXY_TIMEOUT_MS=30000      # → 504 UPSTREAM_TIMEOUT
GATEWAY_UPLOAD_TIMEOUT_MS=60000     # /api/cv/upload

# ── Error reporting to CoreServices (POST /internal/logs) ──────────────────────
# Must equal CoreServices' INTERNAL_API_KEY. Without it, gateway errors are
# written to the console only.
INTERNAL_API_KEY=change-me-to-a-long-random-string
# One RATE_LIMIT_SPIKE warning when a single IP hits limits more than N times
# within the window (individual 429s are not logged).
RATE_LIMIT_SPIKE_THRESHOLD=20
RATE_LIMIT_SPIKE_WINDOW_MINUTES=10
