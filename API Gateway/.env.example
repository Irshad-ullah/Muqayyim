# API Gateway Configuration
PORT=8080

# Downstream microservices (/internal/* is never proxied)
AUTH_SERVICE_URL=http://localhost:3000
CV_SERVICE_URL=http://localhost:8000

# Frontend origins (used for CORS)
MODULE1_FRONTEND_URL=http://localhost:5174
MODULE2_FRONTEND_URL=http://localhost:5173

# Which proxies may set X-Forwarded-For (so req.ip is the real client, needed
# for rate limiting). loopback = local dev (default). Behind Railway/Render's
# proxy set the hop count, usually 1.
TRUST_PROXY=loopback
