# Database (database-per-service: CoreServices owns core_db; AIServices uses ai_db)
MONGODB_URL=mongodb://localhost:27017
CORE_DB_NAME=core_db

# JWT (must match AIServices JWT_SECRET exactly)
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Server
PORT=3000
NODE_ENV=development

# Email (password reset)
EMAIL_SERVICE=gmail
EMAIL_USER=you@example.com
EMAIL_PASSWORD=app-password

# URLs
FRONTEND_URL=http://localhost:5174
AI_SERVICE_URL=http://localhost:8000

# Service-to-service auth: AIServices sends this as X-Internal-Key.
# Must match AIServices INTERNAL_API_KEY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Admin seed (first boot only)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=System Admin

# Login lockout (FR1.2 / SEC-3): lock after N consecutive failed logins, for M minutes
MAX_LOGIN_ATTEMPTS=5
LOCK_DURATION_MINUTES=15

# Which proxies may set X-Forwarded-For (so req.ip is the real client).
# loopback = the local API Gateway (default). Behind Railway/Render use the hop
# count, e.g. 1 (or 2 when requests pass through the gateway as well).
TRUST_PROXY=loopback

# ── Error logging & alerts ─────────────────────────────────────────────────────
# Days to keep error_logs and security_events (TTL index; updated on startup).
LOG_RETENTION_DAYS=30
# Email all active admins when a 'critical' error is logged (Core or AIServices).
ALERTS_ENABLED=true
# At most one alert email per (service, errorType) within this many minutes.
ALERT_THROTTLE_MINUTES=15
