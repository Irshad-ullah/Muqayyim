# Database (database-per-service: CoreServices owns core_db; AIServices uses ai_db)
MONGODB_URL=mongodb://localhost:27017
CORE_DB_NAME=core_db

# JWT (must match AIServices JWT_SECRET exactly)
JWT_SECRET=change-me
JWT_EXPIRE=7d

# Server
PORT=3000
NODE_ENV=development

# Email (password reset)
EMAIL_SERVICE=gmail
EMAIL_USER=you@example.com
EMAIL_PASSWORD=app-password

# URLs
FRONTEND_URL=http://localhost:5174
AI_SERVICE_URL=http://localhost:8000

# Service-to-service auth: AIServices sends this as X-Internal-Key.
# Must match AIServices INTERNAL_API_KEY. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_KEY=change-me-to-a-long-random-string

# Admin seed (first boot only)
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_NAME=System Admin
